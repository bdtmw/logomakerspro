# Public site settings (defaults match the live site; override per environment)
NEXT_PUBLIC_SITE_URL=https://logomakerspro.com

# Hosts allowed in search results (comma separated). Any other host, e.g. *.vercel.app, is sent noindex.
PRODUCTION_HOSTS=logomakerspro.com
# GA4 measurement ID (comma separate several to send to more than one property)
NEXT_PUBLIC_GA_ID=G-VX4M5HDTGV
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-10973222728
NEXT_PUBLIC_META_PIXEL_ID=861664211729887
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LekOy8rAAAAADfvTHUIgOap9Xb7Z6s6OH8TW6sV

# Discount popup (lead magnet): percent shown to visitors, set to false to switch it off
NEXT_PUBLIC_OFFER_PERCENT=15
NEXT_PUBLIC_OFFER_ENABLED=true
# Server-only: the code revealed after signup and accepted at checkout
OFFER_CODE=GOOGLE

# Server-only: Google Gemini API key(s) for the website chat assistant (/api/chat), from aistudio.google.com.
# Several keys can be listed, comma-separated; when one is out of quota the next is used. Without a key the chat
# offers phone and the quote form instead. GEMINI_MODEL is optional (default gemini-flash-latest), and so is
# GEMINI_FALLBACK_MODEL, used when the main model is overloaded (default gemini-flash-lite-latest).
GEMINI_API_KEY=
GEMINI_MODEL=

# Server-only: reCAPTCHA v3 verification (leave empty to skip verification in dev)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Server-only: SMTP used by /api/lead and /api/order to email submissions
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Logo Makers Pro <info@logomakerspro.com>"
MAIL_TO=info@logomakerspro.com

# CRM (/admin). DATABASE_URL: any Postgres connection string (Vercel > Storage > Neon or Supabase sets it for you;
# POSTGRES_URL also works). Tables are created automatically. ADMIN_PASSWORD: at least 8 characters; changing it
# signs out every session. ADMIN_SESSION_SECRET is optional extra signing entropy. CRM_TIMEZONE sets how times
# display (default America/New_York).
DATABASE_URL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRM_TIMEZONE=
